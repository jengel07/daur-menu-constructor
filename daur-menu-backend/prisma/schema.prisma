// daur-menu-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?
  menus    Menu[]
  staff    Staff[]
  orders   Order[]
}

model Menu {
  id               String     @id @default(uuid())
  info             String?    @db.Text
  items            String?    @db.Text
  cats             String?    @db.Text
  general_settings String?    @db.Text
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id         String @id @default(uuid())
  name       String
  orderIndex Int    @default(0)
}

model Dish {
  id         String      @id @default(uuid())
  name       String
  price      Float
  tags       DishTag[]
  orderItems OrderItem[]
}

model Tag {
  id     String    @id @default(uuid())
  name   String    @unique
  dishes DishTag[]
}

model DishTag {
  dishId String
  tagId  String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dishId, tagId])
}

model Staff {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  role         String     @default("Администратор")
  status       String     @default("Активен")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String
  type          String
  status        String      @default("new")
  tableNumber   String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  address       String?
  scheduledTime String?
  comment       String?
  totalPrice    Float
  createdAt     DateTime    @default(now())
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId   String?
  dish     Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)
  name     String
  price    Float
  quantity Int
}